<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.omnibank</groupId>
        <artifactId>omni-bank-service-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>omni-bank-service-agent-boot</artifactId>

    <name>omni-bank-service-agent-boot</name>
    <description>AI 智能体服务实现（端口 8109）：MVC 包结构，业务代码按 agent/conversation/message 包区分场景。</description>

    <dependencies>
        <dependency>
            <groupId>com.omnibank</groupId>
            <artifactId>omni-bank-service-agent-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omnibank</groupId>
            <artifactId>omni-bank-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omnibank</groupId>
            <artifactId>omni-bank-common-web</artifactId>
        </dependency>
        <!-- 数据访问：MyBatis-Plus 支撑 -->
        <dependency>
            <groupId>com.omnibank</groupId>
            <artifactId>omni-bank-common-mybatis</artifactId>
        </dependency>
        <!-- 统一业务线程池（Graph 并行节点 / 模型调用异步化） -->
        <dependency>
            <groupId>com.omnibank</groupId>
            <artifactId>omni-bank-common-threadpool</artifactId>
        </dependency>
        <!-- Spring AI：ChatClient 统一模型调用抽象 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!-- Spring AI OpenAI 兼容实现：对接银行模型网关 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <!-- Spring AI Alibaba Graph：Agent 编排（StateGraph / CompiledGraph） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 探活统一走 /actuator/health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Dubbo RPC（triple 协议）：对外暴露智能体配置查询契约，版本由 dubbo-bom 统一管理 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-registry-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 测试：单元测试 + H2 内存库集成测试（不依赖本地 MySQL） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 本地无 MySQL/Docker 时的联调环境：H2 内存库 + h2 profile，激活方式见 docs/deploy/README.md -->
        <profile>
            <id>local-h2</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
