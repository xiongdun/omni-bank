<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        业务服务聚合模块：信贷/账务/风控/支付等业务域服务统一挂本模块下，新增服务只动这里。
        注意：parent 必须显式 relativePath（默认 ../pom.xml 会指向聚合根，导致解析失败）。
    -->
    <parent>
        <groupId>com.omnibank</groupId>
        <artifactId>omni-bank-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../omni-bank-parent</relativePath>
    </parent>

    <artifactId>omni-bank-service</artifactId>
    <packaging>pom</packaging>

    <name>omni-bank-service</name>
    <description>omni-bank 业务服务聚合模块：customer/product/credit/loan/accounting/payment/recon/risk 八大业务域，每个服务按 api（对外契约）+ biz（服务实现）双模块组织。</description>

    <modules>
        <module>omni-bank-service-customer</module>
        <module>omni-bank-service-product</module>
        <module>omni-bank-service-credit</module>
        <module>omni-bank-service-accounting</module>
        <module>omni-bank-service-payment</module>
        <module>omni-bank-service-recon</module>
        <module>omni-bank-service-risk</module>
    </modules>
</project>
