<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 场景模块：进件申请/授信审批，自包含 controller/rpc 实现，由 credit-biz 装配为单一服务 -->
    <parent>
        <groupId>com.omnibank</groupId>
        <artifactId>omni-bank-service-credit</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>omni-bank-service-credit-credit</artifactId>

    <name>omni-bank-service-credit-credit</name>
    <description>信贷域·授信场景：进件申请与授信审批（后续接 Flowable）。</description>

    <dependencies>
        <dependency>
            <groupId>com.omnibank</groupId>
            <artifactId>omni-bank-service-credit-api</artifactId>
        </dependency>
        <!-- 领域模块不依赖 web/rpc（适配层统一在 biz），应用服务以 Spring Bean 注册 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
